{
  "name": "tonus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run -w tonus-web dev",
    "build": "npm run -w tonus-web build",
    "preview": "npm run -w tonus-web preview",
    "lint": "npm run -w tonus-web lint && npm run -w tonus-mobile lint && eslint . --max-warnings 0",
    "lint:diff": "node scripts/lint-diff.mjs",
    "test": "npm run -w tonus-web test && npm run -w @tonus/shared test && vitest run",
    "test:e2e": "playwright test",
    "check:functions": "node scripts/deno-check.mjs",
    "security:inventory:generate": "node scripts/generate-security-inventory.mjs",
    "security:inventory:check": "node scripts/check-security-inventory.mjs",
    "security:matrix": "node scripts/run-security-negative-matrix.mjs",
    "gen:types": "npx --yes supabase gen types typescript --linked --schema public > packages/shared/src/database.types.ts",
    "gen:types:check": "node scripts/check-db-types.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "media:readme": "node scripts/rebuild-readme-media.mjs",
    "media:readme:record": "node scripts/record-readme-media.mjs",
    "test:readme": "node --test scripts/readme-media-lib.test.mjs && node scripts/validate-readme.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@supabase/supabase-js": "^2.78.0",
    "eslint": "^10.3.0",
    "gifenc": "^1.0.3",
    "globals": "^17.6.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^3.2.6"
  }
}
