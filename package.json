{
  "name": "tonus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:ceiling": "node scripts/lint-ceiling.mjs",
    "lint:diff": "node scripts/lint-diff.mjs",
    "check:functions": "node scripts/deno-check-ceiling.mjs",
    "check:edge-deploy-docs": "node scripts/check-edge-deploy-docs.mjs",
    "deploy:functions": "node scripts/deploy-edge-functions.mjs",
    "gen:types": "npx --yes supabase gen types typescript --linked --schema public > src/lib/database.types.ts",
    "gen:types:check": "node scripts/check-db-types.mjs",
    "test:scripts": "node --test scripts/*.test.mjs && npm run check:edge-deploy-docs",
    "media:readme": "node scripts/rebuild-readme-media.mjs",
    "media:readme:record": "node scripts/record-readme-media.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:readme": "node --test scripts/readme-media-lib.test.mjs && node scripts/validate-readme.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.78.0",
    "ical.js": "^2.2.1",
    "jszip": "^3.10.1",
    "motion": "^12.42.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gifenc": "^1.0.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.6"
  }
}
