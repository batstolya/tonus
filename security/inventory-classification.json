{
  "version": 1,
  "tables": {
    "publicReference": [
      "football_matches"
    ],
    "serviceOnly": [
      "ai_prompts",
      "claude_usage",
      "codex_usage",
      "observability_events",
      "rate_limit_counters"
    ],
    "ownerColumnOverrides": {
      "profiles": "id"
    },
    "credentialTables": [
      "cal_sync",
      "ingest_tokens",
      "telegram_link_tokens",
      "telegram_links",
      "widget_tokens"
    ]
  },
  "views": {
    "daily_metrics": {
      "ownerColumn": "user_id",
      "authOwner": "rls:user_id",
      "dataSensitivity": "health",
      "exposure": "user-owned-view"
    },
    "daily_summary": {
      "ownerColumn": "user_id",
      "authOwner": "rls:user_id",
      "dataSensitivity": "health",
      "exposure": "user-owned-view"
    }
  },
  "rpcs": {
    "claim_due_football_reminders": {
      "signature": "claim_due_football_reminders()",
      "authOwner": "service-role",
      "credentialType": "service-role",
      "dataSensitivity": "health"
    },
    "claim_due_reminder_events": {
      "signature": "claim_due_reminder_events(integer, integer, integer)",
      "authOwner": "service-role",
      "credentialType": "service-role",
      "dataSensitivity": "health"
    },
    "complete_reminder_delivery": {
      "signature": "complete_reminder_delivery(uuid, uuid, bigint, text)",
      "authOwner": "service-role",
      "credentialType": "service-role",
      "dataSensitivity": "health"
    },
    "consume_rate_limit": {
      "signature": "consume_rate_limit(text, integer, integer)",
      "authOwner": "service-role",
      "credentialType": "service-role",
      "dataSensitivity": "internal"
    },
    "fail_reminder_delivery": {
      "signature": "fail_reminder_delivery(uuid, uuid, text, boolean, integer)",
      "authOwner": "service-role",
      "credentialType": "service-role",
      "dataSensitivity": "health"
    },
    "generate_football_reminders": {
      "signature": "generate_football_reminders()",
      "authOwner": "service-role",
      "credentialType": "service-role",
      "dataSensitivity": "health"
    },
    "mark_football_reminder_failed": {
      "signature": "mark_football_reminder_failed(uuid, text)",
      "authOwner": "service-role",
      "credentialType": "service-role",
      "dataSensitivity": "health"
    },
    "mark_football_reminder_sent": {
      "signature": "mark_football_reminder_sent(uuid, bigint)",
      "authOwner": "service-role",
      "credentialType": "service-role",
      "dataSensitivity": "health"
    },
    "schedule_env_sync": {
      "signature": "schedule_env_sync(text)",
      "authOwner": "service-role",
      "credentialType": "service-role",
      "dataSensitivity": "credential"
    },
    "schedule_backup_reminder": {
      "signature": "schedule_backup_reminder(text)",
      "authOwner": "service-role",
      "credentialType": "service-role",
      "dataSensitivity": "credential"
    },
    "delete_user_data": {
      "signature": "delete_user_data(uuid)",
      "authOwner": "service-role",
      "credentialType": "service-role",
      "dataSensitivity": "health"
    }
  },
